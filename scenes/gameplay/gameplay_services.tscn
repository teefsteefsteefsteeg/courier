[node name="GameplayServices" type="Node"]

[node name="CourierWallet" type="Node" parent="."]
script = ExtResource("2_wallet")

[node name="QuestManager" type="Node" parent="." node_paths=PackedStringArray("wallet")]
script = ExtResource("1_qm")
quest_definitions = Array[ExtResource("3_def")]([ExtResource("4_q1"), ExtResource("5_q2"), ExtResource("6_q3")])
wallet = NodePath("../CourierWallet")

[node name="CourierInventory" type="Node" parent="."]
script = ExtResource("7_inventory")
item_definitions = Array[ExtResource("10_item")]([ExtResource("11_wooden_sword"), ExtResource("12_iron_sword"), ExtResource("13_steel_sword"), ExtResource("14_battle_axe"), ExtResource("15_magic_staff"), ExtResource("16_wooden_shield")])

[node name="EquipmentStats" type="Node" parent="." node_paths=PackedStringArray("inventory")]
script = ExtResource("8_equipment")
inventory = NodePath("../CourierInventory")

[node name="SaveGame" type="Node" parent="." node_paths=PackedStringArray("wallet", "inventory", "quest_manager")]
script = ExtResource("9_save")
wallet = NodePath("../CourierWallet")
inventory = NodePath("../CourierInventory")
quest_manager = NodePath("../QuestManager")
