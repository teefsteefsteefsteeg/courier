[node name="GrannyHollis" instance=ExtResource("1_npc")]
npc_name = "Granny Hollis"
lines = PackedStringArray("Come in, come in, wipe your boots. The kettle's always on.", "You look worn thin, dear. Have a lie-down on the bed before you go.", "My grandson writes from the city. Letters are the only thing that crosses that road on time.")
body_color = Color(0.7, 0.5, 0.55, 1)
npc_id = &"granny_hollis"

[node name="Character" type="Node3D" parent="Visual"]
