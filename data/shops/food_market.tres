[resource]
script = ExtResource("1_catalog")
shop_id = &"food_market"
title = "Willowmere Food Market"
greeting = "Fresh bread, ripe fruit, potions from the alchemist's cellar and the guild's own ale. A courier on the road needs to eat!"
sells_materials = Array[ExtResource("2_material")]([ExtResource("3_health_potion"), ExtResource("4_mana_potion"), ExtResource("5_red_apple"), ExtResource("6_bread_loaf"), ExtResource("7_fresh_milk"), ExtResource("8_sweet_grapes"), ExtResource("9_cheese_wheel"), ExtResource("10_roast_ham"), ExtResource("11_raw_steak"), ExtResource("12_warriors_ale"), ExtResource("13_berserker_draught"), ExtResource("14_ironbark_stew")])
