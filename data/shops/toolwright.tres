[gd_resource type="Resource" script_class="ShopCatalog" format=3]

[ext_resource type="Script" path="res://scripts/shop/shop_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/shop/item_definition.gd" id="2_item"]
[ext_resource type="Resource" path="res://data/items/fishing_rod.tres" id="3_fishing_rod"]
[ext_resource type="Resource" path="res://data/items/carpenter_hammer.tres" id="4_carpenter_hammer"]
[ext_resource type="Resource" path="res://data/items/woodcutter_axe.tres" id="5_woodcutter_axe"]
[ext_resource type="Resource" path="res://data/items/miner_pickaxe.tres" id="6_miner_pickaxe"]
[ext_resource type="Resource" path="res://data/items/garden_shovel.tres" id="7_garden_shovel"]
[ext_resource type="Resource" path="res://data/items/mason_trowel.tres" id="8_mason_trowel"]

[resource]
script = ExtResource("1_catalog")
shop_id = &"toolwright"
title = "Hill Smithy Tools"
greeting = "Rods, axes, picks and hammers, courier. And I'll buy whatever you fish, fell or dig up."
items = Array[ExtResource("2_item")]([ExtResource("3_fishing_rod"), ExtResource("4_carpenter_hammer"), ExtResource("5_woodcutter_axe"), ExtResource("6_miner_pickaxe"), ExtResource("7_garden_shovel"), ExtResource("8_mason_trowel")])
buys_materials = true
