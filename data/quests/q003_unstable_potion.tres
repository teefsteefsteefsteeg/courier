[gd_resource type="Resource" script_class="QuestDefinition" format=3 uid="uid://bd5sqn5p7yo1t"]

[ext_resource type="Script" uid="uid://bfcsytpnsnxuy" path="res://scripts/quests/quest_definition.gd" id="1_def"]
[ext_resource type="Script" uid="uid://bc80q17xdqueq" path="res://scripts/quests/quest_objective.gd" id="2_obj"]
[ext_resource type="Script" uid="uid://blm7rvj8tkx6w" path="res://scripts/quests/quest_reward.gd" id="3_rew"]
[ext_resource type="Resource" path="res://data/packages/pkg_potion_crate.tres" id="4_pkg"]

[sub_resource type="Resource" id="Objective_pickup"]
script = ExtResource("2_obj")
type = 1
target_id = &"pkg_potion_crate"
description = "Pick up the Potion Crate at the post office"

[sub_resource type="Resource" id="Objective_deliver"]
script = ExtResource("2_obj")
type = 3
target_id = &"village_alchemist"
description = "Deliver the crate to Alchemist Corvin"
completion_line = "Not a single bottle cracked! Splendid."

[sub_resource type="Resource" id="Reward"]
script = ExtResource("3_rew")
gold = 90
reputation = 15

[resource]
script = ExtResource("1_def")
quest_id = &"q003_unstable_potion"
title = "Unstable Potion"
description = "A crate of volatile potions for the village alchemist. Don't shake it."
giver_id = &"postmaster"
package = ExtResource("4_pkg")
recipient_name = "Alchemist Corvin"
destination_name = "Village Alchemy Shop"
objectives = Array[ExtResource("2_obj")]([SubResource("Objective_pickup"), SubResource("Objective_deliver")])
reward = SubResource("Reward")
recipient_waiting_line = "My potion crate? Bring it gently, please."
recipient_after_line = "The brew is bubbling nicely now."
