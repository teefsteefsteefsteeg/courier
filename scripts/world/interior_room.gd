class_name InteriorRoom
extends Node3D
## Root of an interior scene (Phase 8, generated by tools/generate_interiors.gd). Gives its
## shopkeeper a Merchant at runtime (a Merchant saved inside an NPC scene leaks at exit, see
## the handoff), and wires the room's exit door: "[E] Leave" returns the courier to the
## building's front door in the village (WorldRouter remembers it).

@export var display_name: String = "Inside"
## NPC that runs a shop or service here, and its catalog (empty = none).
@export var shop_keeper: NodePath
@export var shop_catalog: ShopCatalog
## The exit door's Interactable.
@export var exit_interactable: NodePath


func _ready() -> void:
	var keeper := get_node_or_null(shop_keeper) as NPC
	if keeper != null and shop_catalog != null and keeper.get_node_or_null(^"ShopMerchant") == null:
		var merchant := Merchant.new()
		merchant.name = "ShopMerchant"
		merchant.catalog = shop_catalog
		merchant.prompt_verb = "Talk to"
		keeper.add_child(merchant)
	var exit := get_node_or_null(exit_interactable) as Interactable
	if exit != null:
		exit.prompt_verb = "Leave"
		exit.display_name = display_name
		exit.interacted.connect(leave)


## Back out to the village door (also used by tests).
func leave(interactor: Node = null) -> bool:
	var router := get_tree().get_first_node_in_group(&"phase6_router")
	return router != null and bool(router.call(&"travel", &"village", &"", interactor))
